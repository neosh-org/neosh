    "!._*"
  ],
  "optionalDependencies": {
    "@neosh/cli-darwin-arm64": "0.5.1",
    "@neosh/cli-darwin-x64": "0.5.1",
    "@neosh/cli-linux-x64": "0.5.1",
    "@neosh/cli-linux-arm64": "0.5.1"
  }
